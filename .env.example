# Copy to `.env` for local development. In production set these in the environment
# (see docker-compose / deploy docs).

DEBUG=1
# Required when DEBUG is off:
# SECRET_KEY=change-me
# ALLOWED_HOSTS=api.librete.eu

# Defaults to SQLite (db.sqlite3) when unset.
# DATABASE_URL=postgres://librete:librete@localhost:5432/librete

# Origins allowed to call the API (PWA, ionic serve, Capacitor webviews).
# CORS_ALLOWED_ORIGINS=https://librete.eu,capacitor://localhost,https://localhost
# CSRF_TRUSTED_ORIGINS=https://api.librete.eu

# Used in emails (e.g. "account already exists" → password reset page).
FRONTEND_URL=http://localhost:8100

# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# consolemail:// prints emails to the console. Production example:
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=Librete <noreply@librete.eu>

# THROTTLE_ANON=60/minute
# THROTTLE_USER=600/minute
# LOG_LEVEL=INFO
