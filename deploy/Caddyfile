# Serves the Librete PWA and reverse-proxies the API on one domain.
# Caddy obtains and renews the TLS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api/* /_allauth/* /admin/* /static/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web

		# index.html (also served for app routes such as /tasks), the service worker files and
		# the translations must always be revalidated; hashed bundles can be cached forever.
		@nocache {
			not path *.*
		}
		header @nocache Cache-Control "no-cache"
		@nocacheFiles path /index.html /ngsw.json /ngsw-worker.js /manifest.webmanifest /i18n/*
		header @nocacheFiles Cache-Control "no-cache"
		@hashed path_regexp -[A-Za-z0-9_]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
