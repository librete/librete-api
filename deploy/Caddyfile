# Serves the Librete PWA and reverse-proxies the API on one domain.
# Caddy obtains and renews the TLS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api/* /_allauth/* /admin/* /static/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web

		# Angular's service worker files and index.html must always be revalidated;
		# hashed bundles can be cached forever.
		@nocache path / /index.html /ngsw.json /ngsw-worker.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@hashed path_regexp \.[0-9a-f]{16,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
