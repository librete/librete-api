# Production settings for deploy/compose.yaml. Copy to deploy/.env and fill in.
DOMAIN=librete.eu
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=generate-a-long-random-password

# SMTP for verification / password reset emails, e.g.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Librete <noreply@librete.eu>
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Web Push (event reminders in the PWA). Generate the key pair once with
#   docker compose run --rm --no-deps -e RUN_MIGRATIONS=0 api python manage.py generate_vapid_keys
# and keep it: changing it invalidates every browser's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@librete.eu
