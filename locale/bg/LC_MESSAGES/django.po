#: librete/utils/recurrence.py:52
msgid "Enter a valid recurrence rule, e.g. FREQ=WEEKLY;BYDAY=MO."
msgstr "Въведете валидно правило за повторение, напр. FREQ=WEEKLY;BYDAY=MO."

#: librete/utils/recurrence.py:83
msgid "The frequency must be DAILY, WEEKLY, MONTHLY or YEARLY."
msgstr "Честотата трябва да бъде DAILY, WEEKLY, MONTHLY или YEARLY."

#: librete/utils/recurrence.py:87
msgid "UNTIL must be a UTC date and time such as 20301231T235959Z."
msgstr "UNTIL трябва да бъде дата и час в UTC, напр. 20301231T235959Z."

#: librete/utils/recurrence.py:90
msgid "Use either COUNT or UNTIL, not both."
msgstr "Използвайте COUNT или UNTIL, но не и двете."

#: librete/utils/recurrence.py:130
msgid "The recurrence rule never produces an occurrence."
msgstr "Правилото за повторение никога не дава повторение."

#: librete/utils/serializers.py:25
msgid "End date cannot be before start date."
msgstr "Крайната дата не може да бъде преди началната."

#: librete/utils/viewsets.py:19
msgid "This item was changed elsewhere."
msgstr "Този елемент е променен другаде."

#: librete/utils/viewsets.py:38
msgid "The If-Match header must hold a version number."
msgstr "Заглавката If-Match трябва да съдържа номер на версия."
