#: librete/templates/account/email/base_message.txt:1
msgid "Hello from Librete!"
msgstr "Здравейте от Либрете!"

#: librete/templates/account/email/base_message.txt:5
msgid "Thank you for using Librete!"
msgstr "Благодарим ви, че използвате Либрете!"

#: librete/templates/account/email/email_confirmation_message.txt:4
msgid ""
"Your email verification code is listed below. Please enter it in the Librete "
"app."
msgstr ""
"Кодът за потвърждение на имейла ви е по-долу. Въведете го в приложението "
"Либрете."

#: librete/templates/account/email/email_confirmation_message.txt:6
#, python-format
msgid "To confirm your email address, go to %(activate_url)s"
msgstr "За да потвърдите имейл адреса си, отворете %(activate_url)s"

#: librete/templates/account/email/email_confirmation_message.txt:8
msgid "This mail can be safely ignored if you did not sign up for Librete."
msgstr "Ако не сте се регистрирали в Либрете, просто пренебрегнете този имейл."

#: librete/templates/account/email/password_reset_code_message.txt:4
msgid ""
"Your password reset code is listed below. Please enter it in the Librete app."
msgstr ""
"Кодът за смяна на паролата ви е по-долу. Въведете го в приложението Либрете."

#: librete/templates/account/email/password_reset_code_message.txt:8
msgid "This mail can be safely ignored if you did not initiate this action."
msgstr "Ако не сте поискали това, просто пренебрегнете този имейл."

